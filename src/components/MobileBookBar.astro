---
import { getLang, getData, localizePath, stripLang } from '../i18n';
import { getHousePrice, getMinPrice, formatPrice } from '../data/prices';
import Icon from './Icon.astro';
interface Props { href?: string }
const lang = getLang(Astro.currentLocale);
const { site, properties } = getData(lang);
const logical = stripLang(Astro.url.pathname);
const house = properties.find((p) => p.href === logical)?.id;
const amount = house ? getHousePrice(house) : getMinPrice();
const price = amount === null ? null : formatPrice(amount, lang);
const t = {
  es: { wa: 'Escribir por WhatsApp', book: 'Reservar', from: 'desde' },
  en: { wa: 'Message us on WhatsApp', book: 'Book', from: 'from' },
}[lang];
const href = localizePath(Astro.props.href ?? '/#reservar', lang);
---
<div class="bar">
  <a class="wa" href={site.whatsapp.href} aria-label={t.wa}><Icon name="whatsapp" size={24} /></a>
  <a class="cta" {href}>{price ? `${t.book} · ${t.from} ${price}` : t.book}</a>
</div>
<style>
  .bar { display: none; }
  @media (max-width: 767px) {
    .bar { display: flex; gap: 12px; position: fixed; left: 0; right: 0; bottom: 0; z-index: 30; background: var(--white); border-top: 1px solid var(--line); box-shadow: 0 -6px 16px rgba(20, 63, 62, 0.12); padding: 12px 16px; padding-bottom: max(12px, env(safe-area-inset-bottom)); view-transition-name: book-bar; animation: bar-in 700ms var(--ease-out) 500ms backwards; }
  }
  @keyframes bar-in { from { transform: translate3d(0, 110%, 0); } }
  .wa { flex: none; width: 52px; height: 52px; display: flex; align-items: center; justify-content: center; border: 2px solid var(--teal); border-radius: 14px; color: var(--teal); background: var(--white); }
  .cta { flex: 1 1 auto; height: 52px; display: flex; align-items: center; justify-content: center; border-radius: 14px; background: var(--cta); color: var(--white); text-decoration: none; font-size: 17px; font-weight: 800; }
  .wa, .cta { transition: background-color var(--dur-med) var(--ease-out), color var(--dur-med) var(--ease-out), transform var(--dur-fast) var(--ease-out); }
  .cta:hover { background: #9E3D26; color: var(--white); }
  .wa:hover { background: var(--teal); color: var(--white); }
  .wa:active, .cta:active { transform: scale(0.96); }
</style>
