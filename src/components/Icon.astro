---
interface Props {
  name: 'check' | 'train' | 'kitchen' | 'leaf' | 'wifi' | 'whatsapp' | 'menu' | 'close';
  size?: number;
  strokeWidth?: number;
  class?: string;
}
const { name, size = 24, strokeWidth, class: className } = Astro.props;
const paths: Record<string, { d?: string; rect?: boolean; sw: number }> = {
  check: { d: 'M5 12l5 5L20 7', sw: 2.8 },
  train: { d: 'M5 11h14M9 17l-2 4M15 17l2 4M9 14h.01M15 14h.01', rect: true, sw: 1.8 },
  kitchen: { d: 'M4 3v8a2 2 0 002 2h0a2 2 0 002-2V3M6 13v8M17 3c-2 2-3 5-3 8h3v10', sw: 1.8 },
  leaf: { d: 'M12 21V11M12 11c0-4 3-7 7-7 0 4-3 7-7 7zM12 14c0-3-2-5-6-5 0 3 2 5 6 5z', sw: 1.8 },
  wifi: { d: 'M2 9a15 15 0 0120 0M5.5 12.5a10 10 0 0113 0M9 16a5 5 0 016 0M12 19.5h.01', sw: 1.8 },
  whatsapp: { d: 'M21 12a8.5 8.5 0 01-12.6 7.4L3 21l1.6-5.2A8.5 8.5 0 1121 12z', sw: 2 },
  menu: { d: 'M4 7h16M4 12h16M4 17h16', sw: 2.4 },
  close: { d: 'M6 6l12 12M18 6L6 18', sw: 2.4 },
};
const p = paths[name];
---
<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth ?? p.sw}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {p.rect && <rect x="5" y="3" width="14" height="14" rx="3" />}
  <path d={p.d} />
</svg>
