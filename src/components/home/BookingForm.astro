---
// Formulario de reserva del Home.
// NOTA: placeholder del motor de reservas. Aún no hay backend: el formulario
// hace GET a "#" con casa/llegada/salida/huespedes. Cuando exista el motor,
// cambia `action` (y si hace falta los `name`) por los que espere.
import Icon from '../Icon.astro';
import { getLang, getData } from '../../i18n';
import { getMinPrice, formatPrice } from '../../data/prices';

const lang = getLang(Astro.currentLocale);
const d = getData(lang);
const { bookingPerks, guestOptions } = d;
const price = formatPrice(getMinPrice(), lang);

const t = {
  es: { any: 'Cualquiera', title: 'Reserva tu habitación', from: 'desde', night: '/ noche', house: '¿En qué casa?', checkIn: 'Llegada', checkOut: 'Salida', guests: 'Huéspedes', submit: 'Ver habitaciones libres' },
  en: { any: 'Any', title: 'Book your room', from: 'from', night: '/ night', house: 'Which house?', checkIn: 'Check-in', checkOut: 'Check-out', guests: 'Guests', submit: 'See available rooms' },
}[lang];

const casas = [
  { id: 'cualquiera', label: t.any },
  { id: 'pozuelo', label: 'Pozuelo' },
  { id: 'vallarta', label: 'Vallarta' },
];
const defaultCasa = 'pozuelo';
const defaultGuests = guestOptions[1];
---
<form class="bf" aria-labelledby="res-title" method="get" action="#" data-booking>
  <div class="head full">
    <h2 id="res-title" class="title">{t.title}</h2>
    <p class="from">{t.from} <strong>{price}</strong> {t.night}</p>
  </div>

  <div class="field full">
    <span id="res-casa" class="label">{t.house}</span>
    <div class="toggles" role="group" aria-labelledby="res-casa">
      {casas.map((c) => (
        <button type="button" class="toggle" data-casa={c.id} aria-pressed={c.id === defaultCasa ? 'true' : 'false'}>{c.label}</button>
      ))}
    </div>
    <input type="hidden" name="casa" value={defaultCasa} data-casa-input />
  </div>

  <div class="field date">
    <label class="label" for="res-in">{t.checkIn}</label>
    <input class="input" id="res-in" name="llegada" type="date" required data-in />
  </div>
  <div class="field date">
    <label class="label" for="res-out">{t.checkOut}</label>
    <input class="input" id="res-out" name="salida" type="date" required data-out />
  </div>
  <div class="field pax">
    <label class="label" for="res-pax">{t.guests}</label>
    <select class="input" id="res-pax" name="huespedes">
      {guestOptions.map((g, i) => <option value={String(i + 1)} selected={g === defaultGuests}>{g}</option>)}
    </select>
  </div>

  <button type="submit" class="submit full">{t.submit}</button>

  <ul class="perks full">
    {bookingPerks.map((p) => <li><Icon name="check" size={18} strokeWidth={2.8} />{p}</li>)}
  </ul>
</form>

<script>
  const toISO = (d: Date) => new Date(d.getTime() - d.getTimezoneOffset() * 60000).toISOString().slice(0, 10);
  const plusOneDay = (iso: string) => {
    const [y, m, d] = iso.split('-').map(Number);
    return toISO(new Date(y, m - 1, d + 1));
  };

  document.querySelectorAll<HTMLFormElement>('[data-booking]').forEach((form) => {
    // "¿En qué casa?": botones con aria-pressed + input oculto sincronizado
    const hidden = form.querySelector<HTMLInputElement>('[data-casa-input]');
    const toggles = form.querySelectorAll<HTMLButtonElement>('[data-casa]');
    toggles.forEach((btn) => {
      btn.addEventListener('click', () => {
        toggles.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        if (hidden) hidden.value = btn.dataset.casa ?? '';
      });
    });

    // Fechas: mínimo hoy; la salida, al menos una noche después de la llegada
    const inp = form.querySelector<HTMLInputElement>('[data-in]');
    const out = form.querySelector<HTMLInputElement>('[data-out]');
    if (!inp || !out) return;
    const today = toISO(new Date());
    inp.min = today;
    out.min = plusOneDay(today);
    inp.addEventListener('change', () => {
      if (!inp.value) return;
      const min = plusOneDay(inp.value);
      out.min = min;
      if (out.value && out.value < min) out.value = min;
    });
  });
</script>

<style>
  .bf {
    background: var(--white);
    border: 1px solid var(--card-border);
    border-top: 6px solid var(--accent);
    border-radius: 26px;
    padding: 30px 30px 26px;
    box-shadow: var(--shadow-card);
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    align-items: flex-end;
  }
  .full { flex: 1 1 100%; }

  .head { display: flex; flex-wrap: wrap; gap: 4px 24px; align-items: baseline; justify-content: space-between; }
  .title { font-size: 30px; line-height: 1.15; }
  .from { display: flex; align-items: baseline; gap: 8px; color: var(--muted); font-size: 16px; }
  .from strong { font-size: 42px; font-weight: 900; line-height: 1; color: var(--ink); }

  .field { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
  .field.full { gap: 6px; }
  /* fechas a pares y huéspedes en su propia fila: las fechas necesitan ~150px para no cortarse */
  .date { flex: 1 1 calc(50% - 8px); }
  .pax { flex: 1 1 100%; }
  .label { font-size: 13px; font-weight: 800; color: var(--ink); text-transform: uppercase; letter-spacing: 0.04em; }

  .toggles { display: flex; gap: 10px; }
  .toggle {
    flex: 1 1 0;
    min-width: 0;
    height: 52px;
    padding: 0 8px;
    border-radius: 14px;
    border: 1px solid var(--field-border);
    background: var(--field-bg);
    color: var(--ink);
    font-weight: 800;
    font-size: 17px;
    cursor: pointer;
    transition: background-color var(--dur-med) var(--ease-out), border-color var(--dur-med) var(--ease-out), color var(--dur-med) var(--ease-out), transform var(--dur-fast) var(--ease-out);
  }
  .toggle:hover { border-color: var(--teal); }
  .toggle[aria-pressed='true'] { border: 2px solid var(--teal); background: var(--teal); color: var(--white); }

  .input {
    height: 48px;
    width: 100%;
    min-width: 0;
    border: 1px solid var(--field-border);
    border-radius: 12px;
    padding: 0 12px;
    color: var(--ink);
    background: var(--field-bg);
  }
  .input[type='date'] {
    -webkit-appearance: none; appearance: none;
    display: block;
    padding: 0 10px 0 12px;
    font-size: 16px;
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }
  .input[type='date']::-webkit-date-and-time-value { text-align: left; margin: 0; }
  .input[type='date']::-webkit-datetime-edit { padding: 0; flex: 1 1 auto; }
  .input[type='date']::-webkit-datetime-edit-fields-wrapper { padding: 0; }
  .input[type='date']::-webkit-calendar-picker-indicator {
    margin-left: auto; padding: 4px; border-radius: 6px; cursor: pointer; opacity: 0.7;
  }
  .input[type='date']::-webkit-calendar-picker-indicator:hover { opacity: 1; background: var(--mint); }
  .input:focus-visible { border-color: var(--teal); }

  .submit {
    height: 56px;
    border: 0;
    border-radius: var(--pill);
    background: var(--cta);
    color: var(--white);
    font-weight: 800;
    font-size: 19px;
    cursor: pointer;
    transition: background-color var(--dur-med) var(--ease-out), transform var(--dur-med) var(--ease-out), box-shadow var(--dur-med) var(--ease-out);
  }
  .submit:hover { background: #9E3D26; box-shadow: 0 10px 24px rgba(184, 73, 47, 0.3); transform: translateY(-1px); }
  .submit:active, .toggle:active { transform: scale(0.97); }

  .perks { list-style: none; margin: 4px 0 0; padding: 0; display: flex; flex-direction: column; gap: 8px; font-size: 15px; font-weight: 600; color: var(--text-2); }
  .perks li { display: flex; gap: 10px; align-items: center; }
  .perks :global(svg) { flex: none; color: var(--teal); }

  @media (max-width: 767px) {
    .bf { border-top-width: 5px; border-radius: 22px; padding: 22px 18px; gap: 14px; box-shadow: 0 12px 28px rgba(20, 63, 62, 0.14); }
    .head { flex-direction: column; align-items: flex-start; gap: 14px; }
    .title { font-size: 26px; }
    .from { font-size: 15px; }
    .from strong { font-size: 38px; }
    .label { font-size: 12px; }
    .toggles { gap: 8px; }
    .toggle { height: 48px; padding: 0 6px; border-radius: 12px; font-size: 15px; }
    .date { flex-basis: calc(50% - 7px); }
    .pax { flex-basis: 100%; }
    /* ≥16px en campos para que iOS no haga zoom */
    .input { font-size: 16px; }
    .submit { height: 54px; font-size: 18px; }
    .perks { font-size: 14px; }
    .perks li { gap: 8px; }
    .perks :global(svg) { width: 16px; height: 16px; stroke-width: 3; color: currentColor; }
  }
</style>
