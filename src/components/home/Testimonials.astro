---
import { getLang, getData } from '../../i18n';

const lang = getLang(Astro.currentLocale);
const { ratings, reviews } = getData(lang);
const t = {
  es: { kicker: 'suki = me gusta', title: 'Lo que cuentan nuestros huéspedes', aria: 'Puntuaciones de huéspedes', via: 'vía' },
  en: { kicker: 'suki = I like it', title: 'What our guests say', aria: 'Guest ratings', via: 'via' },
}[lang];
---
<section id="opiniones" class="section section--dark" aria-labelledby="opiniones-title">
  <div class="container stack">
    <div class="top">
      <div class="section-head head">
        <p class="kicker">{t.kicker}</p>
        <h2 id="opiniones-title" class="h2">{t.title}</h2>
      </div>
      <ul class="scores" aria-label={t.aria}>
        {ratings.map((r) => (
          <li class="score">
            <strong class="n">{r.score}</strong>
            <span class="txt">
              <span class="d">{r.label}</span><span class="m">{r.shortLabel}</span><br />{r.source}
            </span>
          </li>
        ))}
      </ul>
    </div>
    <div class="quotes">
      {reviews.map((rv) => (
        <figure class="quote lift">
          <blockquote>«{rv.quote}»</blockquote>
          <figcaption><strong>{rv.name}</strong> · {rv.country} · {t.via} {rv.source}</figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .stack { display: flex; flex-direction: column; gap: 40px; }
  .top { display: flex; flex-wrap: wrap; gap: 24px 48px; align-items: flex-end; justify-content: space-between; }
  .head { max-width: 640px; }

  .scores { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 16px; }
  .score { background: var(--dark-card); border-radius: 16px; padding: 14px 18px; display: flex; gap: 12px; align-items: center; }
  .n { font-size: 28px; font-weight: 900; line-height: 1.1; }
  .txt { font-size: 14px; line-height: 1.3; }
  .m { display: none; }

  .quotes { display: flex; flex-wrap: wrap; gap: 24px; }
  .quote {
    flex: 1 1 300px;
    min-width: 0;
    background: var(--white);
    color: var(--text);
    border-radius: 22px;
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  blockquote { margin: 0; font-size: 19px; font-weight: 700; line-height: 1.4; color: var(--ink); }
  figcaption { margin-top: auto; font-size: 15px; color: var(--muted); }
  figcaption strong { color: var(--ink); }

  @media (max-width: 767px) {
    .stack { gap: 18px; }
    .top { gap: 18px; }
    .scores { flex-wrap: nowrap; gap: 10px; width: 100%; }
    .score { flex: 1 1 0; min-width: 0; display: block; border-radius: 14px; padding: 12px; }
    .n { display: block; font-size: 24px; }
    .txt { font-size: 12px; }
    .d { display: none; }
    .m { display: inline; }
    .quotes { flex-direction: column; gap: 18px; }
    .quote { flex-basis: auto; border-radius: 18px; padding: 20px; gap: 12px; }
    blockquote { font-size: 17px; }
    figcaption { font-size: 14px; }
  }
</style>
