---
import { Picture } from 'astro:assets';
import type { Property } from '../../data/site';
import { getLang, localizePath } from '../../i18n';
import { getHousePrice, formatPrice } from '../../data/prices';
import { isFilled } from '../../data/placeholders';

interface Props {
  property: Property;
  bookHref?: string;
}
const { property: p, bookHref = '#reservar' } = Astro.props;
const lang = getLang(Astro.currentLocale);
const amount = getHousePrice(p.id);
const price = amount === null ? null : formatPrice(amount, lang);
const t = {
  es: { rooms: 'habitaciones', from: 'Desde', night: ' / noche', view: 'Ver habitaciones', viewOf: ' de ', book: 'Reservar', bookIn: ' en ' },
  en: { rooms: 'rooms', from: 'From', night: ' / night', view: 'View rooms', viewOf: ' at ', book: 'Book', bookIn: ' at ' },
}[lang];
const roomsLabel = `${p.rooms} ${t.rooms}`;
---
<article class="card lift">
  <div class="media zoom">
    <Picture
      src={p.image}
      formats={['avif', 'webp']}
      widths={[320, 480, 640, 722]}
      sizes="(min-width: 1200px) 560px, (min-width: 920px) 50vw, 100vw"
      width={722}
      height={400}
      fit="cover"
      quality={60}
      loading="lazy"
      decoding="async"
      alt={p.imageAlt}
    />
    <span class="badge" aria-hidden="true">{roomsLabel}</span>
  </div>
  <div class="body">
    <div>
      <p class="eyebrow">{p.area}<span class="rooms"> · {roomsLabel}</span><span class="visually-hidden d-only"> · {roomsLabel}</span></p>
      <h3 class="name">{p.name}</h3>
    </div>
    <ul class="bullets">
      {p.bullets.filter(isFilled).map((b) => <li>{b}</li>)}
    </ul>
    {isFilled(p.summary) && <p class="summary">{p.summary}</p>}
    <div class="foot">
      {price && (
        <p class="price">{t.from} <strong>{price}</strong><span class="per">{t.night}</span></p>
      )}
      <div class="actions">
        <a class="btn btn--outline more" href={localizePath(p.href, lang)}>{t.view}<span class="visually-hidden">{t.viewOf}{p.name}</span></a>
        <a class="btn btn--cta book" href={bookHref}>{t.book}<span class="visually-hidden">{t.bookIn}{p.name}</span></a>
      </div>
    </div>
  </div>
</article>

<style>
  .card {
    flex: 1 1 420px;
    min-width: 0;
    border: 1px solid var(--line);
    border-radius: 24px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    background: var(--white);
  }
  .media { position: relative; height: 320px; overflow: hidden; }
  .media :global(picture), .media :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }
  .badge {
    position: absolute;
    left: 16px;
    top: 16px;
    background: var(--white);
    color: var(--ink);
    font-weight: 800;
    font-size: 14px;
    padding: 6px 12px;
    border-radius: var(--pill);
  }
  .body { padding: 28px; display: flex; flex-direction: column; gap: 16px; flex: 1 1 auto; }
  .eyebrow { margin: 0; }
  .rooms { display: none; }
  .name { margin-top: 4px; font-size: 30px; line-height: 1.15; }
  .bullets { margin: 0; padding: 0 0 0 20px; display: flex; flex-direction: column; gap: 6px; color: var(--text-2); }
  .summary { display: none; }
  .foot {
    margin-top: auto;
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    align-items: center;
    justify-content: space-between;
    padding-top: 12px;
    border-top: 1px solid var(--line);
  }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-left: auto; }
  .more { padding: 12px 20px; }
  .book { padding: 12px 22px; }

  @media (max-width: 767px) {
    .card { border-radius: 20px; }
    .media { height: 180px; }
    .badge { display: none; }
    .body { padding: 18px; gap: 10px; }
    .eyebrow { font-size: 12px; }
    .rooms { display: inline; }
    .d-only { display: none; }
    .name { margin-top: 0; font-size: 24px; }
    .bullets { display: none; }
    .summary { display: block; font-size: 15px; color: var(--text-2); }
    .foot { flex-wrap: nowrap; gap: 12px; padding-top: 10px; }
    .price { font-size: 14px; }
    .price strong { font-size: 22px; }
    .per { display: none; }
    .book { display: none; }
    /* en móvil un único botón teal relleno */
    .more { padding: 0 20px; background: var(--teal); color: var(--white); }
    .more:hover { background: var(--ink); border-color: var(--ink); color: var(--white); }
  }
</style>
