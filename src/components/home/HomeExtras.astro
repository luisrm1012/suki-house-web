---
import { Picture } from 'astro:assets';
import Icon from '../Icon.astro';
import { images } from '../../data/site';
import { getLang, getData, localizePath } from '../../i18n';

const lang = getLang(Astro.currentLocale);
const { homeExtras } = getData(lang);
const t = {
  es: {
    kicker: 'como en casa',
    title: 'Más que una habitación',
    lead: 'En Suki House Pozuelo compartes jardín, terraza y una cocina completa. Prepara tu desayuno, cena al aire libre o lee tranquilamente después de un día en Madrid.',
    more: 'Conoce la casa',
    terrace: 'Terraza cubierta con mesas de forja',
    kitchen: 'Cocina blanca totalmente equipada',
    garden: 'Jardín visto desde la terraza',
  },
  en: {
    kicker: 'feels like home',
    title: 'More than a room',
    lead: 'At Suki House Pozuelo you share a garden, a terrace and a full kitchen. Make your breakfast, have dinner outdoors or read quietly after a day in Madrid.',
    more: 'Discover the house',
    terrace: 'Covered terrace with wrought-iron tables',
    kitchen: 'White, fully equipped kitchen',
    garden: 'Garden seen from the terrace',
  },
}[lang];

const pic = { formats: ['avif', 'webp'] as ('avif' | 'webp')[], quality: 60, loading: 'lazy' as const, decoding: 'async' as const };
---
<section class="section" aria-labelledby="extras-title">
  <div class="container wrap">
    <div class="text">
      <p class="kicker">{t.kicker}</p>
      <h2 id="extras-title" class="h2">{t.title}</h2>
      <p class="lead">{t.lead}</p>
      <ul class="checklist list">
        {homeExtras.map((e) => <li><Icon name="check" size={20} strokeWidth={2.5} />{e}</li>)}
      </ul>
      <a class="btn btn--outline more" href={localizePath('/pozuelo', lang)}>{t.more}</a>
    </div>
    <div class="gallery">
      <div class="ph ph--main zoom">
        <Picture src={images.terraza} {...pic} widths={[320, 480, 640, 722]} sizes="(min-width: 1200px) 360px, 60vw" alt={t.terrace} />
      </div>
      <div class="side">
        <div class="ph ph--side zoom">
          <Picture src={images.cocina} {...pic} widths={[240, 360, 540]} sizes="(min-width: 1200px) 240px, 40vw" alt={t.kitchen} />
        </div>
        <div class="ph ph--side zoom">
          <Picture src={images.jardin} {...pic} widths={[240, 360, 540]} sizes="(min-width: 1200px) 240px, 40vw" alt={t.garden} />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .wrap { display: flex; flex-wrap: wrap; gap: 48px; align-items: center; }
  .text { flex: 1 1 400px; min-width: 0; display: flex; flex-direction: column; gap: 16px; }
  .lead { color: var(--text-2); }
  .list { font-weight: 700; color: var(--ink); }
  .more { align-self: flex-start; margin-top: 8px; padding: 12px 22px; }

  .gallery { flex: 1 1 520px; min-width: 0; display: flex; gap: 16px; }
  .ph { overflow: hidden; border-radius: 24px; }
  .ph :global(picture), .ph :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }
  .ph--main { flex: 3 1 0; min-width: 0; height: 460px; }
  .side { flex: 2 1 0; min-width: 0; display: flex; flex-direction: column; gap: 16px; }
  .ph--side { height: 222px; }

  @media (max-width: 767px) {
    .wrap { gap: 24px; }
    .text { flex-basis: 100%; gap: 12px; }
    .gallery { flex-basis: 100%; gap: 10px; }
    .side { gap: 10px; }
    .ph { border-radius: 18px; }
    .ph--main { height: 290px; }
    .ph--side { height: 140px; }
  }
</style>
