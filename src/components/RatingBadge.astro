---
import type { Rating } from '../data/site';
interface Props { rating: Rating; variant?: 'photo' | 'dark' | 'mint' }
import { getLang } from '../i18n';
const { rating, variant = 'photo' } = Astro.props;
const lang = getLang(Astro.currentLocale);
const t = { es: { on: 'Valoración en' }, en: { on: 'Rating on' } }[lang];
---
{variant === 'photo' && (
  <div class="photo">
    <span class="score">{rating.score}</span>
    <span class="txt-d"><strong>{rating.label}</strong>{t.on} {rating.source}</span>
    <span class="txt-m">{rating.shortLabel} · {rating.source}</span>
  </div>
)}
{variant === 'dark' && (
  <div class="dark">
    <strong class="n">{rating.score}</strong>
    <span>{rating.shortLabel}<br />{rating.source}</span>
  </div>
)}
{variant === 'mint' && (
  <div class="mint">
    <strong class="n">{rating.score}</strong>
    <span>{rating.shortLabel}<br />{rating.source}</span>
  </div>
)}
<style>
  .photo { display: flex; gap: 12px; align-items: center; background: var(--white); border-radius: 16px; padding: 12px 16px; box-shadow: var(--shadow-badge); width: max-content; max-width: 100%; }
  .photo .score { background: var(--ink); color: var(--white); font-weight: 900; font-size: 20px; border-radius: 10px 10px 10px 2px; padding: 6px 10px; line-height: 1.3; }
  .photo .txt-d { font-size: 14px; line-height: 1.3; color: var(--text); }
  .photo strong { display: block; color: var(--ink); }
  .photo .txt-m { display: none; }
  @media (max-width: 767px) {
    .photo { border-radius: 12px; padding: 8px 12px; gap: 10px; box-shadow: none; }
    .photo .score { font-size: 16px; border-radius: 8px 8px 8px 2px; padding: 3px 8px; }
    .photo .txt-d { display: none; }
    .photo .txt-m { display: inline; font-size: 13px; font-weight: 700; color: var(--ink); }
  }
  .dark { display: flex; align-items: center; gap: 12px; background: var(--dark-card); color: var(--white); border-radius: 14px; padding: 12px 16px; font-size: 14px; line-height: 1.3; }
  .dark .n { font-size: 28px; font-weight: 900; line-height: 1.1; }
  .mint { display: flex; align-items: center; gap: 10px; background: var(--mint); color: var(--text); border-radius: 14px; padding: 10px 14px; font-size: 13px; line-height: 1.3; }
  .mint .n { font-size: 22px; font-weight: 900; color: var(--ink); }
  @media (max-width: 767px) {
    .dark { padding: 12px; }
    .dark .n { font-size: 24px; }
  }
</style>
