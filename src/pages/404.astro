---
import Base from '../layouts/Base.astro';
import { localizePath } from '../i18n';
---

<Base
  title="Página no encontrada · Suki House"
  description="La página que buscas no existe. Vuelve al inicio o consulta nuestras habitaciones en Madrid."
  path="/404"
  footer="compact"
  noindex
  showMobileBar={false}
>
  <section class="section nf-section">
    <div class="container not-found">
      <p class="kicker">vaya, esta puerta no lleva a ninguna habitación</p>
      <h1>Página no encontrada</h1>
      <p class="lead">
        La dirección que has abierto no existe o ya no está disponible. Puedes volver a la página de inicio
        o ver directamente las habitaciones de Suki House Pozuelo.
      </p>
      <div class="actions">
        <a class="btn btn--cta btn--lg" href={localizePath('/', 'es')}>Volver al inicio</a>
        <a class="btn btn--outline btn--lg" href={localizePath('/#alojamientos', 'es')}>Ver habitaciones</a>
      </div>
      <p class="en-line" lang="en">Page not found · <a href={localizePath('/', 'en')} hreflang="en">Back to home</a></p>
    </div>
  </section>
</Base>

<style>
  .nf-section { min-height: 62vh; display: flex; align-items: center; }
  .nf-section > :global(*) { flex: 1; }
  .not-found {
    max-width: 640px;
    margin-inline: auto;
    text-align: center;
  }
  h1 {
    font-size: clamp(34px, 4vw, 52px);
    font-weight: 900;
    color: var(--ink);
    margin: 12px 0 16px;
  }
  .lead {
    color: var(--text-2);
    margin: 0 auto 32px;
    max-width: 52ch;
  }
  .en-line {
    margin-top: 24px;
    color: var(--text-2);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
  }
</style>
